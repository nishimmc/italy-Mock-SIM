<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Italy Mock SIM — Testing Only" android:textSize="24sp"
        android:textStyle="bold" android:paddingBottom="20dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="This app does not create a real SIM, mobile network, SMS, calls, ICCID, or IMSI. It only displays mock values for testing."/>
    <TextView android:id="@+id/status" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="18sp"
        android:paddingTop="30dp"/>
</LinearLayout>
